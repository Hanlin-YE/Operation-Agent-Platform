APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
AGENT_API_PORT=8001
# Video analysis uses faster-whisper + PySceneDetect locally, then the same LLM provider for script structuring.
VIDEO_ANALYZER_ENABLED=false
# Leave blank to use agent_root/models/faster-whisper-small when present;
# otherwise faster-whisper downloads the named model from Hugging Face.
VIDEO_WHISPER_MODEL=
VIDEO_ANALYSIS_MAX_BYTES=314572800
# Optional Hugging Face mirror or a local Whisper model directory.
# HF_ENDPOINT=https://hf-mirror.example
# VIDEO_ANALYSIS_JOB_STORE_PATH=data/video-analysis-jobs.json
POSTGRES_PORT=5433
POSTGRES_DSN=postgresql+asyncpg://agent:change-me@postgres:5432/agent
TASK_POLL_INTERVAL_SECONDS=10
TASK_CONCURRENCY=4
TASK_MAX_RETRIES=3

DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CONTROL_APP_ID=
DINGTALK_TASK_TABLE_ID=
DINGTALK_MATERIAL_TABLE_ID=
DINGTALK_ADMIN_OPEN_ID=

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

LLM_PROVIDER=openai_compatible
# Use the same secret as the web app's OPENAI_API_KEY when this agent is enabled.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# `responses` is for OpenAI-compatible /responses providers; the default keeps
# compatibility with existing Chat Completions services.
LLM_API_MODE=chat_completions
LLM_TOKEN_WARN_THRESHOLD=2000
LLM_CONSECUTIVE_WARN_THRESHOLD=5

PLAYWRIGHT_TIMEOUT_MS=20000
CRAWL_ALLOWED_DOMAINS=
RAG_STORAGE_PATH=/data/rag
EMBEDDING_PROVIDER=deterministic_local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
## Comma-separated public seed pages used by the market research launcher.
## The browser never accepts URLs from end users for this workflow.
MARKET_RESEARCH_COMPETITOR_SEED_URLS=
MARKET_RESEARCH_CUSTOMER_SEED_URLS=
