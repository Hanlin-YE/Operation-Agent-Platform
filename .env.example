# Server-only model configuration. Leave OPENAI_API_KEY empty until deployment/local setup.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=

# Optional Python agent proxy
AGENT_API_BASE_URL=http://127.0.0.1:8001
# Optional local video-analyzer service. It should expose POST /api/video-analysis.
VIDEO_ANALYZER_BASE_URL=http://127.0.0.1:8001/api/video-analysis
